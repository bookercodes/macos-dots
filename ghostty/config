window-title-font-family = "JetBrains Mono"
font-family="Berkeley Mono Trial"
clipboard-trim-trailing-spaces = true
bold-is-bright = true
window-padding-x=12
window-padding-y=12
clipboard-paste-protection = false
confirm-close-surface = false
theme = dark:Vesper,light:GitLab Light
font-size=14
macos-option-as-alt = left
macos-titlebar-style = tabs

copy-on-select = true
unfocused-split-opacity = 0.72
macos-icon = retro
resize-overlay = always
background-blur = 20
shell-integration-features = no-title

keybind = shift+enter=text:\x1b\r
keybind = super+comma=unbind

# Tabs
keybind = super+one=unbind
keybind = super+two=unbind
keybind = super+three=unbind
keybind = super+four=unbind
keybind = super+five=unbind
keybind = super+six=unbind
keybind = super+seven=unbind
keybind = super+eight=unbind
keybind = super+nine=unbind
keybind = alt+one=goto_tab:1
keybind = alt+two=goto_tab:2
keybind = alt+three=goto_tab:3
keybind = alt+four=goto_tab:4
keybind = alt+five=goto_tab:5
keybind = alt+six=goto_tab:6
keybind = alt+seven=goto_tab:7
keybind = alt+eight=goto_tab:8
keybind = alt+nine=goto_tab:9
keybind = alt+t=new_tab

# Navigate splits
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:bottom
keybind = alt+k=goto_split:top
keybind = alt+l=goto_split:right

# Resize splits
keybind = alt+shift+h=resize_split:left,10
keybind = alt+shift+j=resize_split:down,10
keybind = alt+shift+k=resize_split:up,10
keybind = alt+shift+l=resize_split:right,10

# Create splits
keybind = alt+d=new_split:right
keybind = alt+shift+d=new_split:down
